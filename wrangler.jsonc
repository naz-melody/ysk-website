{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ysk-website",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {"directory":"./public", "binding":"ASSETS", "run_worker_first":["/api/*", "/media/*"]},
  "d1_databases": [{"binding":"DB", "database_name":"ysk-db", "database_id":"REPLACE_WITH_YOUR_D1_DATABASE_ID", "migrations_dir":"migrations"}]
}
